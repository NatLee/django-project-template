# Copy this file to .env and adjust. Docker Compose and Django both read it.
# Only the first block matters for a first run; the rest has working defaults.

# ======================== Project
# Prefix for container, image, network and volume names, and the title in the admin and API docs.
PROJECT_NAME=my-project
# Port on your machine where NGINX answers: http://localhost:5566
HOST_PORT=5566
# true while developing. With false, SECRET_KEY must be set and the dev pages disappear.
DEBUG=true
# Required when DEBUG=false. Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# ======================== Database (PostgreSQL container)
DB_NAME=app
DB_USER=app
DB_USER_PASSWORD=change-me
DB_HOST=backend-postgres
DB_PORT=5432

# ======================== Redis (cache + websocket channel layer)
REDIS_URL=redis://backend-redis:6379/0

# ======================== Production
# Comma-separated. Keep localhost: the container health check calls http://localhost:8000/api/health.
# Defaults: * when DEBUG=true, localhost,127.0.0.1 when DEBUG=false.
# ALLOWED_HOSTS=example.com,localhost
# CSRF_TRUSTED_ORIGINS=https://example.com
# CORS_ALLOWED_ORIGINS=https://app.example.com
# CORS_ALLOW_ALL_ORIGINS=false
# Secure cookies are on when DEBUG=false; turn off only to test DEBUG=false over plain http.
# SECURE_COOKIES=true
# SECURE_SSL_REDIRECT=false
# SECURE_HSTS_SECONDS=0

# ======================== Optional
# TIME_ZONE=Asia/Taipei
# LANGUAGE_CODE=en-us
# LOG_LEVEL=INFO
# JWT_ACCESS_TOKEN_MINUTES=3600
# JWT_REFRESH_TOKEN_DAYS=1
# Q_WORKERS=3
# CACHE_PAGE=false
# CACHE_TTL=3600

# ======================== API proxy: /api/proxy/<path> -> {API_URL}api/<path>
API_URL=
API_VERSION=v1
# API_PROXY_TIMEOUT=180
# API_PROXY_VERIFY_TLS=true

# ======================== Login history
# "{ip}" is replaced by the address; leave empty to skip the location lookup.
# LOGIN_HISTORY_GEOIP_URL=http://ip-api.com/json/{ip}
# LOGIN_HISTORY_RETENTION_DAYS=90

# ======================== Social login
# A provider is switched on when its client ID is set. Register this redirect URI with the provider:
#   http://localhost:5566/api/allauth/<provider>/login/callback/
# Only these email domains may sign up (comma-separated; empty = any domain).
SOCIALACCOUNT_VALID_EMAIL_DOMAINS=gmail.com,hotmail.com
# Google: https://console.cloud.google.com/apis/credentials
SOCIAL_GOOGLE_CLIENT_ID=
SOCIAL_GOOGLE_CLIENT_SECRET=
# Microsoft: https://learn.microsoft.com/entra/identity-platform/quickstart-register-app
SOCIAL_MICROSOFT_CLIENT_ID=
SOCIAL_MICROSOFT_CLIENT_SECRET=
# SOCIAL_MICROSOFT_TENANT=common
